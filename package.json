{
  "name": "aoyin-desktop-pet",
  "version": "0.3.0",
  "description": "敖隐：Live2D Cubism 优先、精灵动画回退的跨平台透明桌宠",
  "main": "src/main.cjs",
  "author": "QSothoth",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "esbuild src/renderer/renderer.mjs --bundle --format=iife --platform=browser --target=chrome130 --outfile=src/renderer/renderer.bundle.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "npm run build:renderer && electron-builder --win portable --x64 --publish never",
    "pack:mac": "npm run build:renderer && electron-builder --mac zip --x64 --arm64 --publish never",
    "pack:dir": "npm run build:renderer && electron-builder --dir --win --mac --x64 --arm64 --publish never"
  },
  "dependencies": {
    "pixi.js": "^8.13.1",
    "untitled-pixi-live2d-engine": "^1.3.5"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9"
  },
  "build": {
    "appId": "com.qsothoth.aoyin.desktoppet",
    "productName": "Aoyin Desktop Pet",
    "artifactName": "Aoyin-Desktop-Pet-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "files": [
      "src/**/*",
      "resources/**/*",
      "!resources/live2d/**/*.psd",
      "!resources/live2d/**/*.cmo3",
      "!resources/pets/aoyin/actions/*-source.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "resources/icon.png",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": ["zip"],
      "electronLanguages": ["zh-CN", "en-US"],
      "identity": null
    },
    "win": {
      "target": ["portable"],
      "electronLanguages": ["zh-CN", "en-US"]
    },
    "portable": {
      "artifactName": "Aoyin-Desktop-Pet-${version}-Windows-${arch}.exe"
    }
  }
}
